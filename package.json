{
  "name": "agent-gate",
  "version": "0.1.0",
  "description": "Governed AI agents for property-management operations: least-privilege tool grants, human approval gates, PII redaction, audit log, durable runs and rollback, exposed over MCP.",
  "license": "MIT",
  "author": "Kyle Saunders",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-gate": "dist/src/cli.js"
  },
  "scripts": {
    "agent-gate": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test evals",
    "test": "vitest run",
    "eval": "tsx src/cli.ts eval",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
